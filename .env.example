# Copy to server/.env (never commit the real file)
# Leave AI_API_KEY empty to use the deterministic DEMO FALLBACK (works only on the bundled demo sites, is NOT an LLM).
AI_API_KEY=
# Any OpenAI-compatible chat-completions endpoint.
#   OpenAI:  https://api.openai.com/v1
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_S=20
AI_JSON_MODE=true
# Comma-separated extra allowed CORS origins (chrome-extension:// and localhost are allowed by default)
CORS_ORIGINS=
