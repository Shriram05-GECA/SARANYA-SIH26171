{
  "manifest_version": 3,
  "name": "SARANYA",
  "version": "0.2.0",
  "description": "SARANYA — Privacy-Enforcing Browser Agent. Give AI the capability, not the secret.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "offscreen", "tabs"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "SARANYA" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "web_accessible_resources": [
    {
      "resources": ["models/*", "ort/*", "tesseract/*", "dashboard.html", "ui.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
